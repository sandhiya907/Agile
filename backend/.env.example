# Flask Application Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=spendwise-super-secret-flask-key-change-in-prod-2026
JWT_SECRET_KEY=spendwise-jwt-token-secret-change-in-prod-2026
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Database Configuration (MySQL Recommended)
# Example: mysql+pymysql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/spendwise
# Fallback SQLite for quick development/testing:
# DATABASE_URL=sqlite:///spendwise.db

# Frontend Application URL (used for CORS and email links)
FRONTEND_URL=http://localhost:5173

# SMTP Email Server Configuration
# Used for sending secure password reset links.
# For Gmail, use smtp.gmail.com with port 587 and generate a 16-character App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
